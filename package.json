{
  "name": "rollup-mpa-based-testing",
  "version": "1.0.0",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "// 1. Rollup Build Commands": "",
    "start": "npm run rollup:dev",
    "build": "rollup -c",
    "preview": "npx serve dist",

    "// 2. Rollup Development": "",
    "rollup:dev": "cross-env NODE_ENV=development rollup -c -w",
    "rollup:dev:port": "cross-env NODE_ENV=development PORT=$npm_config_port rollup -c -w",

    "// 3. Component Isolation Mode": "",
    "isolation": "cross-env NODE_ENV=development ISOLATION_MODE=true rollup -c -w",
    "isolation:build": "cross-env ISOLATION_MODE=true rollup -c",
    "isolation:preview": "npm run isolation:build && npx serve dist",

    "// 4. Testing Modes": "",
    "test:component": "cross-env NODE_ENV=development TEST_MODE=true rollup -c -w",
    "visual:test": "cross-env NODE_ENV=development VISUAL_TEST_MODE=true rollup -c -w",

    "// 5. Component and Page Generators": "",
    "create:component": "node scripts/create-component-isolation.js",
    "create:page": "node scripts/create-page.js",
    
    "// 6. Vite Commands": "",
    "vite:dev": "cross-env NODE_ENV=development vite",
    "vite:build": "vite build",
    "vite:preview": "vite preview",
    "vite:isolation": "cross-env ISOLATION_MODE=true NODE_ENV=development vite",
    "vite:isolation-catalog": "cross-env ISOLATION_MODE=true NODE_ENV=development vite --open /isolation"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tslib": "^2.6.2"
  },
  "devDependencies": {
    "@rollup/plugin-alias": "^5.0.1",
    "@rollup/plugin-commonjs": "^28.0.3",
    "@rollup/plugin-html": "^1.0.3",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-replace": "^6.0.2",
    "@rollup/plugin-typescript": "^12.1.2",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.2.1",
    "babel-plugin-transform-react-remove-prop-types": "^0.4.24",
    "cross-env": "^7.0.3",
    "glob": "^10.3.10",
    "react-refresh": "^0.14.0",
    "rollup": "^4.40.0",
    "rollup-plugin-copy": "^3.5.0",
    "rollup-plugin-livereload": "^2.0.5",
    "rollup-plugin-scss": "^4.0.0",
    "rollup-plugin-serve": "^3.0.0",
    "sass": "^1.69.5",
    "terser": "^5.24.0",
    "typescript": "^5.8.3",
    "vite": "^5.1.4"
  }
}

